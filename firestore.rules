rules_version = '2';

// Each signed-in user can read and write only their own data: users/{their uid}/items/*.
// Everything else is closed. Paste this into Firebase console -> Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
